[Unit]
Description=RobViz web dashboard and waypoint editor
Wants=network-online.target
After=local-fs.target network-online.target

[Service]
Type=simple
User=rc4
Group=rc4
WorkingDirectory=/home/rc4/fruit_ws
Environment=HOME=/home/rc4
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'set -eo pipefail; test -r /home/rc4/robviz/dist/index.html; source /home/rc4/fruit_ws/scripts/setup_fruit_runtime.bash; set -u; exec ros2 launch fruit_robviz_bridge waypoint_editor.launch.py'

Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
Alias=waypoint-editor.service roboviz.service
