[Unit]
Description=Foxglove Bridge ROS 2 launch
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=rc4
Group=rc4
WorkingDirectory=/home/rc4/fruit_ws
Environment=HOME=/home/rc4
Environment=ROS_DISTRO=humble
Environment=FOXGLOVE_SERVICE_TIMEOUT_SEC=5
ExecStart=/bin/bash -lc 'set -eo pipefail; source /home/rc4/fruit_ws/scripts/setup_fruit_runtime.bash; set -u; exec ros2 launch foxglove_bridge foxglove_bridge_launch.xml'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
