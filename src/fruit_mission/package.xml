<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fruit_mission</name>
  <version>0.1.0</version>
  <description>Minimal A/B/C fruit competition mission orchestration.</description>
  <maintainer email="edmounds@163.com">rc4</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>composition_interfaces</depend>
  <depend>rcl_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>fruit_perception</depend>
  <depend>fruit_interfaces</depend>
  <exec_depend>fruit_arm_planner</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>std_srvs</depend>
  <exec_depend>fruit_qr_planner</exec_depend>
  <exec_depend>auto_serial_bridge</exec_depend>
  <exec_depend>fruit_nav_bringup</exec_depend>
  <exec_depend>fruit_robviz_bridge</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
