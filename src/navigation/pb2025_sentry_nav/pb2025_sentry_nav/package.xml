<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pb2025_sentry_nav</name>
  <version>1.3.2</version>
  <description>MID360 Point-LIO and GLIM/GICP navigation for a differential-drive robot.</description>
  <maintainer email="lihanchen2004@163.com">Lihan Chen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>fruit_navigation</depend>
  <depend>loam_interface</depend>
  <depend>joy_linux</depend>
  <depend>pb_gicp_localization</depend>
  <depend>pb_glim_map_tools</depend>
  <depend>sensor_scan_generation</depend>
  <depend>livox_ros_driver2</depend>
  <depend>point_lio</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
