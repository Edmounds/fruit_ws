<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fruit_waypoint_rviz_plugin</name>
  <version>0.1.0</version>
  <description>RViz panel for recording fruit waypoint test and competition points.</description>
  <maintainer email="fruit-ws@example.com">fruit_ws team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>pluginlib</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <rviz_common plugin="${prefix}/plugins/plugin_description.xml"/>
    <build_type>ament_cmake</build_type>
  </export>
</package>
