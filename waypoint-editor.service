[Unit]
Description=Fruit waypoint web editor
Wants=network-online.target
After=local-fs.target network-online.target

[Service]
Type=simple
User=rc4
Group=rc4
WorkingDirectory=/home/rc4/fruit_ws
Environment=HOME=/home/rc4
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash -lc 'set -eo pipefail; source /home/rc4/fruit_ws/setup_fruit_runtime.bash; set -u; exec ros2 launch fruit_waypoint_recorder waypoint_editor.launch.py'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
